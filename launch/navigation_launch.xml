<launch>
    <!-- saved SLAM map and how long to wait (seconds) before starting Nav2 -->
    <arg name="map" default="$(env HOME)/maps/warehouse_map.yaml"/>
    <arg name="nav_delay" default="30.0"/>

    <let name="nav2_params" value="$(find-pkg-share automatic_mobile_robot)/config/nav2_params.yaml"/>

    <!-- 1) Gazebo + robot + ros2_control + bridge + cmd_vel relay -->
    <include file="$(find-pkg-share automatic_mobile_robot)/launch/sim_launch.xml"/>

    <!-- 2) Nav2 + RViz, started after the simulation is up -->
    <timer period="$(var nav_delay)">
        <include file="$(find-pkg-share nav2_bringup)/launch/bringup_launch.py">
            <arg name="map" value="$(var map)"/>
            <arg name="params_file" value="$(var nav2_params)"/>
            <arg name="use_sim_time" value="true"/>
            <arg name="slam" value="False"/>
            <arg name="autostart" value="true"/>
            <arg name="use_composition" value="False"/>
        </include>

        <node pkg="rviz2" exec="rviz2" output="screen"
              args="-d $(find-pkg-share nav2_bringup)/rviz/nav2_default_view.rviz">
            <param name="use_sim_time" value="true"/>
        </node>
    </timer>
</launch>
