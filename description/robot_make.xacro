<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="chassis_mass" value="5.0"/>
    <xacro:property name="wheel_mass" value="0.5"/>
    <xacro:property name="wheel_width" value="0.05"/>
    <xacro:property name="caster_radius" value="0.04"/>
    <link name="base_footprint"/>
    <link name="chassis_link">
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="${length} ${breath} ${height}"/></geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="${length} ${breath} ${height}"/></geometry>
            <material name="blue"/>
        </visual>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${chassis_mass}"/>
            <inertia ixx="${chassis_mass/12*(breath*breath+height*height)}" ixy="0" ixz="0"
                     iyy="${chassis_mass/12*(length*length+height*height)}" iyz="0"
                     izz="${chassis_mass/12*(length*length+breath*breath)}"/>
        </inertial>
    </link>
    <joint name="chassis_joint" type="fixed">
        <origin xyz="0 0 ${height/2+wheel_radius}" rpy="0 0 0"/>
        <parent link="base_footprint"/>
        <child link="chassis_link"/>
    </joint>
    <xacro:macro name="wheel" params="name y">
        <link name="${name}_wheel">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="${wheel_mass}"/>
                <inertia ixx="${wheel_mass/12*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)}" ixy="0" ixz="0"
                         iyy="${wheel_mass/12*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)}" iyz="0"
                         izz="${0.5*wheel_mass*wheel_radius*wheel_radius}"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                <material name="white"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            </collision>
        </link>
        <joint name="${name}_wheel_joint" type="continuous">
            <origin xyz="${-(length/4)} ${y} ${-height/2}" rpy="${-pi/2} 0 0"/>
            <parent link="chassis_link"/>
            <child link="${name}_wheel"/>
            <axis xyz="0 0 1"/>
        </joint>
    </xacro:macro>
    <xacro:wheel name="left"  y="${breath/2+wheel_width/2}"/>
    <xacro:wheel name="right" y="${-(breath/2+wheel_width/2)}"/>
    <link name="castor_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="${2/5*0.2*caster_radius*caster_radius}" ixy="0" ixz="0"
                     iyy="${2/5*0.2*caster_radius*caster_radius}" iyz="0"
                     izz="${2/5*0.2*caster_radius*caster_radius}"/>
        </inertial>
        <visual>
            <geometry><sphere radius="${caster_radius}"/></geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry><sphere radius="${caster_radius}"/></geometry>
        </collision>
    </link>
    <joint name="castor_wheel_joint" type="fixed">
        <origin xyz="${length/4} 0 ${-(height/2+wheel_radius-caster_radius)}" rpy="0 0 0"/>
        <parent link="chassis_link"/>
        <child link="castor_wheel"/>
    </joint>
</robot>